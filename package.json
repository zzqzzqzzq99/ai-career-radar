{
  "name": "ai-career-radar",
  "version": "0.3.0",
  "description": "面向法律人及其他行业转型者的公开 AI 招聘情报看板。",
  "private": true,
  "license": "MIT",
  "author": "Zhuoqun Zhang",
  "repository": {
    "type": "git",
    "url": "https://github.com/zzqzzqzzq99/ai-career-radar.git"
  },
  "homepage": "https://zzqzzqzzq99.github.io/ai-career-radar/",
  "keywords": [
    "ai-career",
    "legal-ai",
    "legal-tech",
    "job-tracker",
    "career-intelligence"
  ],
  "engines": {
    "node": ">=22.13.0"
  },
  "scripts": {
    "dev": "vinext dev",
    "build": "vinext build",
    "build:pages": "vite build --config vite.pages.config.ts",
    "refresh:jobs": "node scripts/refresh-jobs.mjs && node scripts/refresh-global.mjs",
    "start": "vinext start",
    "test": "vinext build && vite build --config vite.pages.config.ts && node --test tests/*.test.mjs",
    "lint": "eslint . --ignore-pattern dist --ignore-pattern pages-dist --ignore-pattern .next"
  },
  "dependencies": {
    "next": "16.3.2",
    "react": "19.2.8",
    "react-dom": "19.2.8"
  },
  "devDependencies": {
    "@cloudflare/vite-plugin": "1.53.1",
    "@tailwindcss/postcss": "4.2.1",
    "@types/node": "22.19.19",
    "@types/react": "19.2.14",
    "@types/react-dom": "19.2.3",
    "@vitejs/plugin-react": "6.0.2",
    "@vitejs/plugin-rsc": "0.5.34",
    "eslint": "9.39.4",
    "eslint-config-next": "16.3.2",
    "react-server-dom-webpack": "19.2.8",
    "tailwindcss": "4.2.1",
    "typescript": "5.9.3",
    "vinext": "1.0.0-beta.8",
    "vite": "8.2.2",
    "wrangler": "4.125.0"
  },
  "type": "module"
}
